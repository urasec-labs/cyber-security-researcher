# ============================================================================
# ORTAM DEGİŞKENLERİ (`.env.example` -> `.env` olarak kopyalayin)
# ============================================================================
# Bu dosyayi Git'e COMMIT ETMEYIN. `.gitignore` icinde `.env` olmali.
# Sirlar ortam degiskenlerinden okunur; kaynak koda gomulmez.
# ============================================================================

# ------------------------------------------------------------- TELEGRAM
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqr
TELEGRAM_CHAT_ID=987654321

# ------------------------------------------------------------- LLM SAGLAYICI
# LLM_PROVIDER: "ollama" (yerel, veri disari cikmaz) | "openai"
LLM_PROVIDER=ollama
LLM_PROVIDER_NOTE=ollama icin API anahtari gerekmez; openai icin asagida doldurun

# --- Ollama ---
OLLAMA_HOST=http://127.0.0.1:11434
# Ollama'da hangi modelin kurulu oldugunu `ollama list` ile ogrenin.
# Dogrulama: curl http://127.0.0.1:11434/api/tags
LLM_MODEL=qwen2.5:14b-instruct

# --- OpenAI (LLM_PROVIDER=openai ise) ---
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- OpenAI-uyumlu yerel sunucu (vLLM / LM Studio / llama.cpp) ---
# OPENAI_API_KEY=yok-sonrasi-anahtar-gerekmez
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=local-model-adiniz

# --- LLM ayarlari ---
LLM_ENABLED=true
# Zaman asimi. Olcum: Ollama'da 5GB llama modeli, CPU-only, ~130 sn surdu.
# Uzak API kullaniyorsaniz 60 yapabilirsiniz.
LLM_TIMEOUT=180
LLM_MAX_RETRIES=2
# Ayni anda gidecek LLM cagrisi. Dusuk tutmak kotayi korur.
LLM_MAX_CONCURRENCY=2

# ------------------------------------------------------------- NVD (CVSS)
# API anahtari OLMADAN: 5 istek / 30 saniye. Anahtariyla: 50 istek / 30 saniye.
# Anahtar: https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=
# NVD_RATE_LIMIT=5

# ------------------------------------------------------------- MODUL 3: NUCLEI
# KAPSAM: Yalnizca assets.txt icindeki varliklar taranir.
#
# CYBER_DRY_RUN=true (VARSAYILAN): komut kurulur ve loglanir, CALISTIRILMAZ.
# Gercek tarama icin IKISINI DE ayarlayin:
#   CYBER_DRY_RUN=false
#   CYBER_CONFIRM_SCAN=true
CYBER_DRY_RUN=true
CYBER_CONFIRM_SCAN=false

# Esik deger: bu CVSS'un altindaki zafiyetler taranmaz.
SCAN_MIN_CVSS=8.0

# Kendi altyapinizi yuklemeyin.
NUCLEI_RATE_LIMIT=50
NUCLEI_BINARY=nuclei
# NUCLEI_TEMPLATES=C:\path\to\nuclei-templates

# Varlik dosyalarinin konumu
# CYBER_ASSETS_FILE=assets.txt
# CYBER_CVE_ASSET_MAP=cve_asset_map.json

# ------------------------------------------------------------- GENEL
CHECK_INTERVAL=1800
REQUEST_TIMEOUT=30
LOG_LEVEL=INFO
# CYBER_DB_PATH=data\cyber_intel.db
# CYBER_DATA_DIR=data